# --- Authentik OIDC ---
# Issuer is the public URL browsers reach Auth at, e.g.
#   .../application/o/giftlstr/  (see README, "Swapping identity providers")
# Leave empty to disable sign-in.
AUTHENTIK_ISSUER=
# Optional: URL the server uses to fetch the discovery/JWKS/token when it
# cannot reach AUTHENTIK_ISSUER directly (defaults to AUTHENTIK_ISSUER).
# Under the compose stack this defaults to http://server:9000/application/o/giftlstr/
# (Authentik's internal DNS name); only set it when Authentik runs elsewhere.
AUTHENTIK_ISSUER_BACKEND=
# Set after creating the OIDC provider in Authentik (required for sign-in).
AUTHENTIK_CLIENT_ID=
# Authentik user attribute (or mapped OIDC claim) carrying the MM-DD birthday.
AUTHENTIK_BIRTHDAY_CLAIM=birthday
# External subject IDs (Authentik `sub` UUIDs, comma-separated) granted admin.
ADMIN_USER_IDS=

# --- Authentik services (docker-compose only) ---
AUTHENTIK_TAG=latest
# Generate with `pnpm docker:genenv` (writes real random values into
# .env.local) or set these manually. The compose dev-defaults below are
# public/insecure and must be replaced before any exposed deployment:
#   AUTHENTIK_SECRET_KEY = dev-only-insecure-secret-key-change-before-production
#   AUTHENTIK_POSTGRESQL__PASSWORD / AUTHENTIK_BOOTSTRAP_PASSWORD = authentik
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_TOKEN=giftlstr-bootstrap
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Backups (see README). Enabled by setting GIFT_AUTO_BACKUP_ENABLED=1.
GIFT_AUTO_BACKUP_ENABLED=0
GIFT_AUTO_BACKUP_INTERVAL=24h
GIFT_AUTO_BACKUP_KEEP_DAILY=7
GIFT_AUTO_BACKUP_KEEP_WEEKLY=4
GIFT_BACKUP_DIR=

# Rate limiting (see README). Enabled by setting GIFT_RATE_LIMIT_ENABLED=1.
GIFT_RATE_LIMIT_ENABLED=0
GIFT_RATE_LIMIT=120
GIFT_RATE_LIMIT_STRICT=30
GIFT_RATE_LIMIT_WINDOW=1m